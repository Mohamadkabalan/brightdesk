# Copy this file to .env (cp .env.example .env) and fill in real values.
# .env is listed in .gitignore. NEVER commit it. This file has no secrets and IS committed.

# Which LLM backend to use: anthropic | openai | local | fake
LLM_PROVIDER=anthropic

# Anthropic, the primary provider in this book. Create a key in the Anthropic Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI, the secondary provider. Model IDs change often: check the models page.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Local or open-weight models through any OpenAI-compatible server (e.g. Ollama)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2

# Reliability
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Retrieval: hash | sentence-transformers | openai
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Infrastructure. Leave DATABASE_URL empty until Chapter 15.
DATABASE_URL=
LOG_LEVEL=INFO
